# En prod, on passe par le proxy Vercel /api → Railway (rewrite dans
# vercel.json). Ça rend le cookie de session first-party, sinon Safari
# ITP et Chrome 3rd-party-cookies blocking le suppriment au refresh.
# Pour le développement local, le proxy Vite (vite.config.js) gère
# le routage /api → http://localhost:8000.
VITE_API_URL=/api
