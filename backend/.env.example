# =============================================================================
# Yotori Finance — Configuration backend (sans Docker)
# =============================================================================
# Copie ce fichier en backend/.env et adapte les valeurs.
# Ne JAMAIS committer backend/.env (il contient ta clé secrète).
# =============================================================================

# -----------------------------------------------------------------------------
# Clé secrète JWT — OBLIGATOIRE, génère une vraie valeur :
#   Mac/Linux : openssl rand -hex 32
#   Windows   : powershell -Command "[Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Durée de session (10080 min = 7 jours)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Base de données
# SQLite (par défaut, aucune installation requise) :
#   DATABASE_URL=sqlite:///./yotori.db
# PostgreSQL (si tu veux migrer plus tard) :
#   DATABASE_URL=postgresql://user:password@localhost:5432/yotori
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./yotori.db

# -----------------------------------------------------------------------------
# CORS — origines autorisées pour le frontend
# En développement local :
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# En production sur un domaine :
# CORS_ORIGINS=https://yotori.tondomaine.com
# -----------------------------------------------------------------------------

DEBUG=false

# -----------------------------------------------------------------------------
# IA — catégorisation des transactions (optionnel, BYOK)
# Deux providers supportés ; sans aucune clé, la catégorisation fonctionne
# uniquement par regex (règles builtin + règles custom).
#   - Anthropic : https://console.anthropic.com  (sert aussi au Coach)
#   - OpenAI    : https://platform.openai.com/api-keys (catégorisation seule ;
#                 créditer le compte — l'API est facturée à l'usage)
# AI_PROVIDER : auto (défaut — Anthropic si clé posée, sinon OpenAI),
#               anthropic, ou openai (forcé, sans bascule silencieuse).
# -----------------------------------------------------------------------------
# Le provider sert la catégorisation ET le coach personnel du Dashboard.
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# AI_PROVIDER=auto
# AI_MODEL_CATEGORIZE_OPENAI=gpt-4o-mini
# AI_MODEL_COACH_OPENAI=gpt-4o-mini

# -----------------------------------------------------------------------------
# GoCardless Bank Account Data — synchro bancaire automatique (open banking PSD2)
# Créer une paire de clés sur https://bankaccountdata.gocardless.com/user/secrets/
# GOCARDLESS_SECRET_ID  : UUID public ("Secret ID")
# GOCARDLESS_SECRET_KEY : la clé secrète associée
# GOCARDLESS_REDIRECT_URI : URL de retour après consentement bancaire
#   (en prod : l'URL Vercel ; en local : http://localhost:5173)
# -----------------------------------------------------------------------------
GOCARDLESS_SECRET_ID=your-secret-id-uuid
GOCARDLESS_SECRET_KEY=your-secret-key
GOCARDLESS_REDIRECT_URI=http://localhost:5173
